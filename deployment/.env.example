# -----------------------------------------------------------------------------
# Price Updater — Docker Compose overrides
#
# Copy this file to `.env` (next to docker-compose.yml) and adjust it.
# Compose reads `.env` automatically; it must never be committed.
# -----------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=pricesgrid
MYSQL_USER=pricegrid_user_db
MYSQL_PASSWORD=change-me

# --- API: secrets (change every one of them outside a local environment) ------
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
API_KEY_HASH_SECRET=dev-api-key-hash-secret-change-me

# Exact origin the browser uses to reach the web client (see WEB_PORT below).
CORS_ORIGIN=http://localhost:4200

LOG_LEVEL=info

# Demo seeds create the demo company, its catalog and the two login accounts.
ALLOW_DEMO_SEED=true

# Keep it false while the stack is served over plain HTTP, or the browser will
# drop the refresh cookie. Set it to true behind HTTPS.
COOKIE_SECURE=false

# --- Initial accounts created by the seeds ----------------------------------
SEED_GLOBAL_ADMIN_EMAIL=global.admin@pricesgrid.local
SEED_GLOBAL_ADMIN_PASSWORD=ChangeMe!123
SEED_TENANT_ADMIN_EMAIL=tenant.admin@pricesgrid.local
SEED_TENANT_ADMIN_PASSWORD=ChangeMe!123

# --- Published ports --------------------------------------------------------
API_PORT=3000
WEB_PORT=4200

# --- Web client -------------------------------------------------------------
# The API base URL is compiled into the Angular bundle. Leave it empty to use
# the value committed in src/environments/environment.ts, or set the public URL
# of your API when the stack runs on another host:
#   WEB_API_URL=https://prices.example.com/api/v1
WEB_API_URL=
