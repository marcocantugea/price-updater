# ---------------------------------------------------------------------------
# Price Updater API — environment configuration example
# Copy to .env and adjust. NEVER commit real secrets.
#
# NOTE: the `pricesgrid` / `pricegrid_user_db` names below are inherited
# compatibility values, not branding. Existing installations keep their current
# database name, user and seeded @pricesgrid.local emails; renaming them would
# require a data migration. See README.md > "Legacy infrastructure names".
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000

# MySQL connection.
#   - Dedicated application user (recommended):
#       CREATE DATABASE pricesgrid CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#       CREATE USER 'pricegrid_user_db'@'localhost' IDENTIFIED BY '<strong-password>';
#       GRANT ALL PRIVILEGES ON pricesgrid.* TO 'pricegrid_user_db'@'localhost';
#   - Or the local root account for a throwaway dev database.
DATABASE_URL="mysql://pricegrid_user_db:change-me@127.0.0.1:3306/pricesgrid"
# DATABASE_URL="mysql://root@127.0.0.1:3306/pricesgrid"

# JWT secrets (change in every non-local environment)
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# Secret used to hash API keys before storing them
API_KEY_HASH_SECRET=dev-api-key-hash-secret-change-me

# CORS: the Angular dev server origin
CORS_ORIGIN=http://localhost:4200

# Logging: debug | info | warn | error
LOG_LEVEL=info

# --- Seeds -----------------------------------------------------------------
# Demo seeds (company + demo users + catalog demo data) only run when this is
# true (or when NODE_ENV=development). Keep it false in staging/production.
ALLOW_DEMO_SEED=true

# Initial users created by the seeds (development credentials — CHANGE THEM)
SEED_GLOBAL_ADMIN_EMAIL=global.admin@pricesgrid.local
SEED_GLOBAL_ADMIN_PASSWORD=ChangeMe!123
SEED_TENANT_ADMIN_EMAIL=tenant.admin@pricesgrid.local
SEED_TENANT_ADMIN_PASSWORD=ChangeMe!123

# Separate database for the integration suite (`npm run test:integration`).
# It is a DIFFERENT database on purpose: the suite applies migrations, runs the
# seeds, and writes rows. Never point it at the database you develop against.
DATABASE_URL_TEST="mysql://user:password@127.0.0.1:3306/pricesgrid_test"
